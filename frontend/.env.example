# KapraOS Frontend Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.

# Backend REST API base URL
# In local development with Vite dev server, /api is automatically
# proxied to http://127.0.0.1:8000. For direct access or production,
# set this to the full backend URL (e.g., http://localhost:8000).
VITE_API_URL=/api

# Clerk Authentication Publishable Key
# Obtain this key from Clerk Dashboard -> API Keys -> Publishable key.
# Example: pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
