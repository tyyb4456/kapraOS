# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Async SQLAlchemy connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://kapraos_app:changeme@localhost:5432/kapraos

# Used only by Alembic for the *sync* fallback if ever needed; normally unused
# because alembic/env.py reuses DATABASE_URL in async mode.
# DATABASE_URL_SYNC=postgresql+psycopg2://kapraos_app:changeme@localhost:5432/kapraos

APP_NAME=KapraOS API
APP_ENV=local
DEBUG=true

# Echo SQL statements to stdout (verbose; keep false outside local debugging).
DB_ECHO=false

# Redis read-cache (Step 10). Optional: when unset/empty the app runs with a
# process-local in-memory cache backend (same TTL/invalidation semantics).
# Production should point at a managed Redis, e.g.:
# REDIS_URL=redis://:changeme@redis:6379/0
# Set CACHE_ENABLED=false to disable caching entirely (DB remains authoritative).
# REDIS_URL=
# CACHE_ENABLED=true
# Set CACHE_LOG_HITS=true to log every cache HIT/MISS/SET at INFO level
# (key prefix only, never values) — handy to watch Redis work in the terminal.
# CACHE_LOG_HITS=false

# Clerk authentication (Step 11)
# Get these from the Clerk Dashboard → API Keys page.
# CLERK_SECRET_KEY = sk_test_... or sk_live_...
# CLERK_JWT_KEY = PEM-formatted RSA public key (from Dashboard → API Keys → Show JWT public key)
# CLERK_AUTHORIZED_PARTIES = comma-separated list of allowed frontend origins
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://yourapp.com

# AI layer (model served through xKiro, an OpenAI-compatible gateway).
# 1. Copy this file to `.env` (gitignored — never commit the real key).
# 2. Paste your xKiro key from the dashboard:
# XKIRO_API_KEY=xk-...
# 3. Optionally override the gateway URL or model id (`vendor/model`):
# XKIRO_BASE_URL=https://api.xkiro.com/v1
# XKIRO_MODEL=deepseek/deepseek-v4.1-flash:free

# Realtime voice (Step 11 — LiveKit Cloud, optional).
# 1. Create a free project at https://cloud.livekit.io and copy its URL +
#    API key + secret below. Without these, voice routes answer 503 and the
#    rest of the app (including text /ai/chat) works unchanged.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...
# 2. Optionally override the worker agent name (must match on both sides):
# VOICE_AGENT_NAME=kapraos-voice
# 3. Optionally swap the LiveKit Inference STT/TTS models (provider
#    independent — business logic never depends on these):
#    STT default deepgram/nova-3 + language multi covers English + Urdu +
#    mixed speech; TTS default cartesia/sonic-3.6 supports Urdu output.
# VOICE_STT_MODEL=deepgram/nova-3
# VOICE_STT_LANGUAGE=multi
# VOICE_LLM_MODEL=google/gemma-4-31b-it
# VOICE_TTS_MODEL=cartesia/sonic-3.6
# VOICE_TTS_VOICE=