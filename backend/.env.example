# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Async SQLAlchemy connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://fabric_app:changeme@localhost:5432/fabric_pos

# Used only by Alembic for the *sync* fallback if ever needed; normally unused
# because alembic/env.py reuses DATABASE_URL in async mode.
# DATABASE_URL_SYNC=postgresql+psycopg2://fabric_app:changeme@localhost:5432/fabric_pos

APP_NAME=Fabric POS API
APP_ENV=local
DEBUG=true

# Echo SQL statements to stdout (verbose; keep false outside local debugging).
DB_ECHO=false